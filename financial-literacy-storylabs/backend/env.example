# Financial Literacy StoryLabs Backend Environment Variables (Gemini-Only Version)

# Required: Google Gemini API Key (for story AND image generation) - FREE TIER AVAILABLE!
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: ElevenLabs API Key (for premium voice synthesis)
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# Access code for the application (choose your own password)
ACCESS_CODE=your-chosen-access-code-here

# Application settings
ENVIRONMENT=development
LOG_LEVEL=INFO 